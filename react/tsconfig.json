{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "jsx": "react-jsx", "strict": true, "declaration": true, "emitDeclarationOnly": true,
    "rootDir": "src", "outDir": ".", "skipLibCheck": false, "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.tsx"],
  "exclude": ["node_modules"]
}
