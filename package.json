{
  "name": "@monabbous/lumenmorph",
  "version": "0.1.0",
  "description": "Low-markup glass surfaces, pointer light, and optional SVG text from nabous.dev.",
  "type": "module",
  "license": "ISC",
  "author": "Mohamed Nabous <https://nabous.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monabbous/lumenmorph.git"
  },
  "homepage": "https://github.com/monabbous/lumenmorph#readme",
  "bugs": "https://github.com/monabbous/lumenmorph/issues",
  "style": "./dist/css/lumenmorph.css",
  "sass": "./scss/lumenmorph.scss",
  "less": "./less/lumenmorph.less",
  "exports": {
    ".": {
      "types": "./js/pointer.d.ts",
      "import": "./js/pointer.mjs"
    },
    "./css": "./dist/css/lumenmorph.css",
    "./motion": "./dist/css/motion.css",
    "./scss": "./scss/lumenmorph.scss",
    "./scss/mixins": "./scss/_mixins.scss",
    "./scss/motion": "./scss/_motion.scss",
    "./less": "./less/lumenmorph.less",
    "./less/motion": "./less/motion.less",
    "./tailwind": "./tailwind/index.cjs",
    "./react": {
      "types": "./react/index.d.ts",
      "import": "./react/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "scss/",
    "less/",
    "tailwind/",
    "js/",
    "react/",
    "AGENTS.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.less"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "tailwindcss": ">=3.4 <5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:types": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "glassmorphism",
    "css",
    "scss",
    "less",
    "tailwind",
    "pointer",
    "glow",
    "react",
    "svg"
  ],
  "devDependencies": {
    "@monabbous/slidebox": "1.3.2",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/node": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "less": "^4.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.90.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-v4": "npm:tailwindcss@^4.1.0",
    "typescript": "^5.9.0"
  }
}
